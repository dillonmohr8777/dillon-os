{
  "id": "dillon-command",
  "name": "Dillon Command Center",
  "version": 1,
  "contract": "11_Agents/64gb Morning Orchestrator Spec 2026-07-08.md",
  "codex_handoff": "11_Agents/Next Codex 64GB Orchestrator Handoff 2026-07-08.md",
  "parallel_lane_cap": 8,
  "tier_policy": {
    "0": "read, analyze, draft, vault writes, deterministic CLIs — unattended",
    "1": "reversible platform tweaks — one approval executes the batch",
    "2": "send, post, deploy, spend, credentials — prepared only, never autonomous"
  },
  "lanes": [
    {
      "id": "comms",
      "label": "Gmail / Slack / inbox triage",
      "codex_lane": "B",
      "tier_default": 0,
      "parallel_group": "scout",
      "skills": ["slack-intake", "inbox-brief"],
      "outputs": [
        "00_Inbox/slack/",
        "Daily-Briefs/slack-intake-YYYY-MM-DD.md",
        "Daily-Briefs/inbox-brief-YYYY-MM-DD.md"
      ],
      "preflight": []
    },
    {
      "id": "clients",
      "label": "Client roster pulse + frontmatter health",
      "codex_lane": "F",
      "tier_default": 0,
      "parallel_group": "scout",
      "skills": ["client-pulse"],
      "outputs": ["Daily-Briefs/pulse-today.md"],
      "preflight": [
        {
          "script": "_os/automation/bin/frontmatter-validate.js",
          "args": []
        }
      ]
    },
    {
      "id": "intelligence",
      "label": "Research sweep + Grok/xAI ingest",
      "codex_lane": "H",
      "tier_default": 0,
      "parallel_group": "scout",
      "skills": ["research-sweep"],
      "outputs": [
        "12_Brain/06_Research/",
        "12_Brain/state/grok-intelligence-ingest.json"
      ],
      "preflight": []
    },
    {
      "id": "websites",
      "label": "Site health sentinel + property QA",
      "codex_lane": "D",
      "tier_default": 0,
      "parallel_group": "scout",
      "skills": ["site-grade", "ux-audit"],
      "outputs": [
        "Daily-Briefs/site-health-report.md",
        "12_Brain/state/site-health-sentinel.json"
      ],
      "preflight": [
        {
          "script": "_os/automation/bin/site-health.js",
          "args": []
        }
      ]
    },
    {
      "id": "outreach",
      "label": "Prospect radar + site-factory queue",
      "codex_lane": "Mac pipeline",
      "tier_default": 0,
      "parallel_group": "scout",
      "skills": ["site-factory", "site-batch", "site-grade"],
      "outputs": [
        "12_Brain/queue/",
        "08_Prospects/",
        "02_Campaigns/AI Site Builder Outreach Engine/"
      ],
      "preflight": [
        {
          "script": "_os/automation/bin/queue-status.js",
          "args": []
        }
      ]
    },
    {
      "id": "ads",
      "label": "Paid media scouts + metrics",
      "codex_lane": "C",
      "tier_default": 0,
      "parallel_group": "scout",
      "skills": ["metrics-pull"],
      "outputs": ["01_Clients/*/Optimization Ledger.md"],
      "preflight": []
    },
    {
      "id": "reporting",
      "label": "Client report factory",
      "codex_lane": "F",
      "tier_default": 0,
      "parallel_group": "scout",
      "skills": ["client-report"],
      "outputs": ["Daily-Briefs/reports/"],
      "preflight": []
    },
    {
      "id": "command",
      "label": "AM report + plan synthesis",
      "codex_lane": "A",
      "tier_default": 0,
      "parallel_group": "command",
      "skills": ["am-report", "plan-today"],
      "outputs": [
        "Daily-Briefs/am-report-YYYY-MM-DD.md",
        "Daily-Briefs/plan-YYYY-MM-DD.md",
        "Dashboard.md",
        "automation-runs/dillon-command/YYYY-MM-DD/approval-board.md"
      ],
      "preflight": [],
      "runs_after": "scout"
    }
  ]
}
