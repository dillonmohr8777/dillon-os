# Prospect Radar V2 — copy to a gitignored .env. Never put secrets here.

# PostgreSQL. Required for durable private state in any non-test environment.
# Local: docker compose -f _os/radar-engine/docker-compose.yml up -d
DATABASE_URL=postgres://radar:radar@127.0.0.1:5433/radar_v2

# Bind address for the intake / QA / report server.
RADAR_V2_HOST=127.0.0.1
RADAR_V2_PORT=4343

# Public origin used when minting report and CTA URLs.
RADAR_V2_PUBLIC_ORIGIN=http://127.0.0.1:4343

# Shared secret for the internal QA queue. Leave empty to refuse QA writes.
RADAR_V2_QA_TOKEN=

# HMAC secret for booking / CRM webhooks. Required before any webhook is accepted.
RADAR_V2_WEBHOOK_SECRET=

# Optional encryption key for sensitive columns (32-byte hex). Empty = no field encryption.
RADAR_V2_FIELD_KEY=

# Kill switch. When true, report delivery, CRM writes, and outreach are refused.
RADAR_V2_KILL_SWITCH=true

# Write/send capabilities. All default off. Dry-run adapters still write previews
# to the private database; they never call a live provider unless these are true
# AND a separate approval record exists.
RADAR_V2_ENABLE_REPORT_DELIVERY=false
RADAR_V2_ENABLE_CRM=false
RADAR_V2_ENABLE_OUTREACH=false
RADAR_V2_ENABLE_EMAIL=false
RADAR_V2_ENABLE_SLACK=false

# Auto-approval stays off. The first 25 reports always require a human.
RADAR_V2_AUTO_APPROVE=false
RADAR_V2_MANDATORY_QA_COUNT=25

# Captcha adapter: "off" (tests), "dry-run" (accept token shape only), "turnstile".
RADAR_V2_CAPTCHA=off
RADAR_V2_CAPTCHA_SECRET=

# Storage: "fs" (local) or "object" (private FS with object:// refs; S3 stays off).
RADAR_V2_STORAGE=fs
RADAR_V2_STORAGE_DIR=
RADAR_V2_OBJECT_LIVE=false

# Object-storage interface placeholders. Unused until a provider is chosen.
RADAR_V2_S3_BUCKET=
RADAR_V2_S3_REGION=
RADAR_V2_S3_ENDPOINT=

# Live provider flags. All stay false. A key alone is not permission to call out.
RADAR_V2_CAPTCHA_LIVE=false
RADAR_V2_PLACES_LIVE=false
# Fetch a real public homepage after intake. Off by default. Fixture domains still scan locally.
RADAR_V2_LIVE_SCAN=false

# Momentum identity on reports. Use the agency address, never a personal one.
MOMENTUM_BRAND_NAME=NeedMomentum
MOMENTUM_CONTACT_NAME=NeedMomentum
MOMENTUM_CONTACT_EMAIL=hello@needmomentum.com
MOMENTUM_CONTACT_URL=https://needmomentum.com
MOMENTUM_BOOKING_URL=https://needmomentum.com/book
MOMENTUM_PRIVACY_URL=/privacy
MOMENTUM_TERMS_URL=/terms

# Optional Places key — inherited from the existing radar. Never commit it.
# GOOGLE_PLACES_API_KEY=

# Retention (days). Deletion hooks honour these.
RADAR_V2_RETENTION_DAYS=365
RADAR_V2_REPORT_TTL_DAYS=90

# Score version. Immutable. Do not change without a new snapshot type.
RADAR_V2_SCORE_VERSION=radar-v2.0.0
