# IMMOHRTAL CLAW — local or gated phone tunnel. Copy to .env. Never commit.

PORT=4800
CLAW_HOST=127.0.0.1

CLAW_CONTEXT_TOKENS=128000
CLAW_MAX_TOOL_ITERS=24
CLAW_MEMORY_MAX_BYTES=8589934592
CLAW_SEARCH_SCAN_BYTES=33554432
CLAW_MAX_OUTPUT_TOKENS=8192
CLAW_PROVIDER_TIMEOUT_MS=120000

# Optional: vault root for kb_search / kb_read (defaults to the dillon-os repo root)
# CLAW_VAULT_ROOT=

# Which brain. Catalog ids in src/models.js
# CLAW_MODEL=claude-opus-5

# Local Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# CLAW_QWEN_MODEL=qwen3.6:27b
# CLAW_GEMMA_MODEL=gemma4:31b
# CLAW_CODER_MODEL=qwen3-coder:latest
# CLAW_LLAMA_MODEL=llama4:scout
# CLAW_DEEPSEEK_LOCAL_MODEL=deepseek-v4:flash

# Cloud. Put keys here locally. Never commit this file.
# Align HCM Anthropic (Opus 5 first):
# ANTHROPIC_API_KEY=
# CLAW_ANTHROPIC_MODEL=claude-opus-5

# OpenAI Sol:
# OPENAI_API_KEY=
# CLAW_OPENAI_MODEL=gpt-5.6-sol

# xAI Grok 4.6 (second cloud brain):
# XAI_API_KEY=
# CLAW_GROK_MODEL=grok-4.6

# Google Gemini (fifth cloud family):
# GEMINI_API_KEY=
# CLAW_GEMINI_MODEL=gemini-2.5-pro

# Cursor Composer 2.5 has no public API. Only if you have a private gateway:
# CLAW_COMPOSER_BASE_URL=
# CLAW_COMPOSER_API_KEY=
# CLAW_COMPOSER_MODEL=composer-2.5

# Legacy single-endpoint override still works:
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen3.6:27b

# Phone tunnel. Always set a gate code if CLAW_TUNNEL=1.
# CLAW_TUNNEL=0
# CLAW_GATE_TOKEN=

# Second-brain checker. Defaults to Grok, then Gemini, then any ready
# family that is not the one that produced the answer.
# CLAW_CHECKER_MODEL=grok-4.6

# Anthropic prompt caching on the system block. On by default. 0 disables.
# CLAW_PROMPT_CACHE=1

# Gated skills. A skill stays out of the prompt until its variable is set.
# CLAW_CALENDAR_API_KEY=
# CLAW_CDP_URL=

# Optional heartbeat interval in ms. 0 = off.
# CLAW_HEARTBEAT_MS=0

# CLAW_WORKSPACE=/absolute/path/to/workspace
# CLAW_DATA_DIR=/absolute/path/to/data

# Shell stays approval-gated.
# CLAW_ALLOW_EXEC=0
