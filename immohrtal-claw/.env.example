# IMMOHRTAL CLAW — local staging only. Copy to .env. Never commit the copy.
# Publish / Custom GPT / public host stays approval-gated.

PORT=4800
CLAW_HOST=127.0.0.1

# Context and disk memory. PicoClaw targets ~10MB RAM. CLAW keeps the loop
# in process and lets long-term memory grow on disk (default 8 GiB).
CLAW_CONTEXT_TOKENS=128000
CLAW_MAX_TOOL_ITERS=16
CLAW_MEMORY_MAX_BYTES=8589934592
CLAW_SEARCH_SCAN_BYTES=33554432

# Providers. Leave unset to use the local booth rehearsal provider (no network).
# Point at Ollama for a local model, or any OpenAI-compatible base URL.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen3.8:27b
# OPENAI_API_KEY=ollama

# Optional overrides. Leave unset to use the packaged workspace and data dirs.
# CLAW_WORKSPACE=/absolute/path/to/workspace
# CLAW_DATA_DIR=/absolute/path/to/data

# Shell stays approval-gated. The exec tool is staged-off even if this is 1.
# CLAW_ALLOW_EXEC=0
