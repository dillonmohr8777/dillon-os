# Anthropic API key — the only place it lives. Never ships in the app.
ANTHROPIC_API_KEY=sk-ant-...

# Secret used to sign session tokens issued after Sign in with Apple.
SESSION_SECRET=change-me-to-a-long-random-string

# Your app's bundle ID — must match the `aud` claim in Apple identity tokens.
APPLE_BUNDLE_ID=com.mohrmedia.mohragents

# App Store Connect shared secret / server notification setup happens in
# App Store Connect; the webhook endpoint is /v1/webhooks/appstore.

# Apple Root CA - G3 SHA-256 fingerprint (hex), used to pin the App Store
# notification/transaction JWS chain. Get it from
# https://www.apple.com/certificateauthority/ (download the G3 cert, then
# `openssl x509 -in AppleRootCA-G3.cer -inform der -fingerprint -sha256`).
# REQUIRED in production — without it the webhook fails closed and grants nothing.
APPLE_ROOT_CA_FINGERPRINT=

# Dev-only escape hatch: accept UNVERIFIED App Store payloads when NODE_ENV
# is not "production". Never set this in production.
ALLOW_UNVERIFIED_APPSTORE=false

PORT=8787

# Entitlement store (JSON file, swappable for a real DB).
ENTITLEMENTS_FILE=./data/entitlements.json

# Per-user chat rate limit: RATE_MAX_PER_WINDOW requests per RATE_WINDOW_MS.
RATE_WINDOW_MS=300000
RATE_MAX_PER_WINDOW=20

# Set to "true" to let signed-in users chat without an active subscription
# (useful for TestFlight review builds and local development).
ALLOW_UNSUBSCRIBED=false
