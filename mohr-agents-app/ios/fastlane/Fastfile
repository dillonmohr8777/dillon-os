# Builds and uploads Mohr Agents to App Store Connect from a hosted macOS
# runner — no local Mac needed. Auth is an App Store Connect API key (set as
# CI secrets), so no Apple ID password or 2FA is involved.
#
# Signing uses Xcode automatic signing with -allowProvisioningUpdates, which
# creates/downloads the distribution certificate and provisioning profile on
# the runner using the same API key. Nothing to store in a match repo.

default_platform(:ios)

SCHEME = "MohrAgents"
PROJECT = "MohrAgents.xcodeproj"

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"), # base64-encoded .p8
    is_key_content_base64: true,
    in_house: false,
  )
end

platform :ios do
  before_all do
    # XcodeGen produces the .xcodeproj from project.yml (CI runs this first,
    # but do it here too so the lane works when invoked directly).
    xcodegen(spec: "project.yml") if File.exist?("project.yml")
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    key = asc_key
    increment_build_number(
      build_number: latest_testflight_build_number(api_key: key, initial_build_number: 0) + 1,
      xcodeproj: PROJECT,
    )
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  desc "Build and submit to App Store review"
  lane :release do
    key = asc_key
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
    )
    # Uploads the binary + metadata/screenshots from fastlane/metadata &
    # fastlane/screenshots if present; submit_for_review can be flipped on
    # once the listing is filled in.
    upload_to_app_store(
      api_key: key,
      submit_for_review: false,
      automatic_release: false,
      force: true,             # skip the interactive HTML preview
      precheck_include_in_app_purchases: false,
      skip_screenshots: true,  # add screenshots in App Store Connect first
    )
  end
end
