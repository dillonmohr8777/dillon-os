# unignored below; they are generated by the scripts in ../align-hcm-intro/.
build/*
!build/fonts.css
!build/wordmark.path
!build/wordmark.vb
!build/noise.b64
!build/icons3d.js
!build/shot.mjs
!build/copycheck.mjs

__pycache__/
