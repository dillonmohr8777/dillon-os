{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dillon-os/skill-acceptance-registry-v1",
  "title": "Production Skill Acceptance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "skillPath",
          "fixtures",
          "commands",
          "reviewCommands",
          "expectedFiles",
          "requiredPatterns",
          "forbiddenPatterns",
          "independentReview",
          "timeoutSeconds",
          "retryLimit"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "skillPath": { "type": "string", "minLength": 1 },
          "fixtures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "reviewCommands": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "expectedFiles": { "type": "array", "items": { "type": "string" } },
          "requiredPatterns": { "type": "array", "items": { "type": "string" } },
          "forbiddenPatterns": { "type": "array", "items": { "type": "string" } },
          "independentReview": { "const": true },
          "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "retryLimit": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
