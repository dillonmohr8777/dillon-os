{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dillon-os/agent-definition-v1",
  "title": "Dillon Managed Agent Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agentId",
    "displayName",
    "category",
    "purpose",
    "orchestration",
    "authority",
    "routing",
    "memory",
    "tools",
    "actionClasses",
    "runtime",
    "budget",
    "evidence",
    "acceptanceChecks",
    "legacyAliases"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "agentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "category": { "enum": ["control", "delivery", "assurance", "sentinel"] },
    "purpose": { "type": "string", "minLength": 1 },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "canDelegate", "maxWorkers", "maxDepth", "verifierAgentId"],
      "properties": {
        "pattern": { "enum": ["sequential", "parallel", "router", "orchestrator", "evaluator"] },
        "canDelegate": { "type": "boolean" },
        "maxWorkers": { "type": "integer", "minimum": 0, "maximum": 3 },
        "maxDepth": { "type": "integer", "minimum": 0, "maximum": 1 },
        "verifierAgentId": { "type": ["string", "null"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalQueueWrite",
        "canonicalBrainWrite",
        "correctionLedgerWrite",
        "externalDelivery",
        "spend",
        "accountChange",
        "secretAccess",
        "artifactAcceptance",
        "finalSynthesis"
      ],
      "properties": {
        "canonicalQueueWrite": { "type": "boolean" },
        "canonicalBrainWrite": { "type": "boolean" },
        "correctionLedgerWrite": { "type": "boolean" },
        "externalDelivery": { "type": "boolean" },
        "spend": { "type": "boolean" },
        "accountChange": { "type": "boolean" },
        "secretAccess": { "type": "boolean" },
        "artifactAcceptance": { "type": "boolean" },
        "finalSynthesis": { "type": "boolean" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientRequired", "identityReceiptRequired", "clientScope", "portalIsolation"],
      "properties": {
        "clientRequired": { "type": "boolean" },
        "identityReceiptRequired": { "type": "boolean" },
        "clientScope": { "enum": ["none", "registry-resolved", "synthetic-only", "personal-local-only"] },
        "portalIsolation": { "type": "array", "items": { "type": "string" } }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localReadScopes", "localWriteScopes", "managedDurableMemory"],
      "properties": {
        "localReadScopes": { "type": "array", "items": { "type": "string" } },
        "localWriteScopes": { "type": "array", "items": { "type": "string" } },
        "managedDurableMemory": { "const": "disabled" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny"],
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actionClasses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic", "approvalGated", "prohibited"],
      "properties": {
        "automatic": { "type": "array", "items": { "type": "string" } },
        "approvalGated": { "type": "array", "items": { "type": "string" } },
        "prohibited": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "managedEligibility", "managedPilot", "managedRestrictions"],
      "properties": {
        "default": { "enum": ["local", "hybrid"] },
        "managedEligibility": { "enum": ["blocked-local", "synthetic", "later-read-only"] },
        "managedPilot": { "type": "boolean" },
        "managedRestrictions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "timeoutSeconds", "maxRetries"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLocatorsRequired", "artifactHashesRequired", "degradedReceiptRequired"],
      "properties": {
        "sourceLocatorsRequired": { "type": "boolean" },
        "artifactHashesRequired": { "type": "boolean" },
        "degradedReceiptRequired": { "type": "boolean" }
      }
    },
    "acceptanceChecks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "legacyAliases": { "type": "array", "items": { "type": "string" } }
  }
}
