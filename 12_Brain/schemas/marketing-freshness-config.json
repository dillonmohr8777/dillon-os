{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dillon-os/marketing-freshness-config",
  "title": "MarketingFreshnessExperimentConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_id", "as_of", "pages"],
  "properties": {
    "client_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,63}$"
    },
    "as_of": { "type": "string", "format": "date" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_id", "url", "configured_review_date", "cadence_days"],
        "properties": {
          "page_id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "configured_review_date": { "type": "string", "format": "date" },
          "cadence_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "description": "Configured experiment cadence, not a citation-supported fact."
          }
        }
      }
    }
  }
}
