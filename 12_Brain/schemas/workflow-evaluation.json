{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dillon-os/workflow-evaluation",
  "title": "MakerCheckerWorkflow",
  "type": "object",
  "required": [
    "workflow_id",
    "task",
    "maker_id",
    "checker_id",
    "artifact_paths",
    "acceptance_tests",
    "rollback"
  ],
  "properties": {
    "workflow_id": { "type": "string", "minLength": 1 },
    "workflow_type": {
      "type": "string",
      "enum": ["general", "website_factory"]
    },
    "task": { "type": "string", "minLength": 1 },
    "maker_id": { "type": "string", "minLength": 1 },
    "checker_id": { "type": "string", "minLength": 1 },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "rollback": { "type": "string", "minLength": 1 },
    "demo_recording_path": { "type": "string", "minLength": 1 },
    "visual_review_required": { "type": "boolean" },
    "human_gate": { "type": "boolean" },
    "budget_tokens": { "type": "number", "exclusiveMinimum": 0 },
    "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "workflow_type": { "const": "website_factory" } },
        "required": ["workflow_type"]
      },
      "then": {
        "required": ["demo_recording_path", "visual_review_required"],
        "properties": {
          "visual_review_required": { "const": true }
        }
      }
    }
  ]
}
