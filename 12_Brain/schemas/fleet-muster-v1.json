{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dillon-os/fleet-muster-v1",
  "title": "Synthetic Fleet Muster Scenario v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "scenarioId",
    "synthetic",
    "identityReceipt",
    "seededTraps",
    "agentInputs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenarioId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "synthetic": { "const": true },
    "identityReceipt": {
      "type": "object",
      "additionalProperties": true,
      "required": ["receiptId", "clientId", "brandId", "classification", "validated"],
      "properties": {
        "receiptId": { "type": "string", "minLength": 1 },
        "clientId": { "type": "string", "minLength": 1 },
        "brandId": { "type": "string", "minLength": 1 },
        "classification": { "const": "synthetic" },
        "validated": { "const": true }
      }
    },
    "seededTraps": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type", "description", "expectedDetectorAgentIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^FM-T[0-9]{3}-[A-Z0-9-]+$" },
          "type": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "expectedDetectorAgentIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
          }
        }
      }
    },
    "agentInputs": {
      "type": "object",
      "minProperties": 15,
      "maxProperties": 15,
      "additionalProperties": {
        "type": "object",
        "required": ["exercise", "sourceLocators", "expectedBehaviors", "expectedTrapIds", "expectedArtifact"],
        "properties": {
          "exercise": { "type": "string", "minLength": 1 },
          "sourceLocators": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^fixture:" }
          },
          "expectedBehaviors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "expectedTrapIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^FM-T[0-9]{3}-" }
          },
          "expectedArtifact": { "type": "string", "pattern": "^fixture:" }
        }
      }
    }
  }
}
