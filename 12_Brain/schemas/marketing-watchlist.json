{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dillon-os/marketing-watchlist",
  "title": "ClientMarketingWatchlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_id", "client_ref", "vertical", "x_handles", "narrative_keywords", "search_budgets"],
  "properties": {
    "client_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,63}$"
    },
    "client_ref": {
      "type": "string",
      "pattern": "^01_Clients/.+\\.md$"
    },
    "vertical": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "x_handles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^@?[A-Za-z0-9_]{1,15}$"
      }
    },
    "narrative_keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "search_budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_x_search_calls", "max_web_search_calls"],
      "properties": {
        "max_x_search_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_web_search_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    }
  }
}
