{
  "name": "cmo-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CMO OS - the auditable, multi-client AI CMO runtime. Zero runtime dependencies.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cmo": "./bin/cmo.js"
  },
  "scripts": {
    "start": "node bin/serve.js",
    "cmo": "node bin/cmo.js",
    "demo": "node bin/cmo.js demo --seed",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "doctor": "node bin/cmo.js doctor"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1"
  }
}
