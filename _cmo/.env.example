# CMO OS configuration. Every line is optional - the product runs with none of them.
# Copy to .env (gitignored). Never commit a real value.

# --- provider ---------------------------------------------------------------
# Unset => the deterministic offline provider. The whole pipeline still runs.
# ANTHROPIC_API_KEY=

# quality (default: premium tier everywhere) | balanced | economy
# CMO_ROUTING_PROFILE=quality

# --- spend caps, per workspace ----------------------------------------------
# CMO_BUDGET_DAILY_USD=5
# CMO_BUDGET_MONTHLY_USD=100
# CMO_BUDGET_PER_RUN_USD=1.5

# --- server -----------------------------------------------------------------
# CMO_PORT=4343
# CMO_HOST=127.0.0.1
# CMO_DATA_DIR=data

# --- connectors: each one promotes a lane from fixture to live ---------------
# Zero-friction (OAuth consent or an API key only):
# CMO_GOOGLE_OAUTH_JSON=        # Search Console + Analytics
# CMO_GA4_PROPERTY_ID=
# CMO_PLACES_API_KEY=           # stands in for GBP while its quota request is pending
# CMO_PSI_API_KEY=
# CMO_SERP_API_KEY=

# Calendar-time approvals - start these before you need them:
# CMO_GOOGLE_ADS_DEVELOPER_TOKEN=   # requires Google review
# CMO_GBP_ACCOUNT_ID=               # requires an access request; ZERO default quota
# CMO_META_ACCESS_TOKEN=            # requires App Review for accounts you do not own

# Publishing (approval-gated and idempotency-keyed; no publisher is implemented yet):
# CMO_WP_URL=
# CMO_WP_APP_PASSWORD=
# CMO_SLACK_WEBHOOK=
