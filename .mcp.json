{
  "mcpServers": {
    "landingfolio": {
      "type": "http",
      "url": "https://mcp.landingfolio.com/mcp",
      "headers": {
        "Authorization": "Bearer ${LANDINGFOLIO_TOKEN}"
      }
    },
    "playwright-isolated": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.69", "--headless", "--isolated", "--no-sandbox"]
    }
  }
}
