{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Slack__*"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"- $(date '+%Y-%m-%d %H:%M') \u2014 session ended (run /session-mine if decisions were made)\" >> \"$CLAUDE_PROJECT_DIR/12_Brain/01_Captures/sessions/session-log.md\""
          }
        ]
      }
    ]
  }
}
