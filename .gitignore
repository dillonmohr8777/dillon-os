.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/obsidian-local-rest-api/data.json
08_Assets/

# Large binaries never belong in git
*.zip

# Node
node_modules/
.next/
dist/

# Playwright QA output
_templates/site-factory/qa-shots/

# Public-safety scanner writes this allowlisted fixture during tests
_os/test/fixtures/

# Harvested third-party reference material (screenshots, source imagery)
_templates/site-factory/harvest/

# 12_Brain private layer — credentials, access inventories, and recovery
# locators stay out of Git even in a private repo.
12_Brain/private/**
!12_Brain/private/README.md

# Local environment files — MCP tokens (LANDINGFOLIO_TOKEN) belong here, never in Git
.env
.env.*
!.env.example

# Radar V2 local artifacts (PII-capable). Never commit.
_os/radar-engine/artifacts/
_os/radar-engine/.data/

# Site grader: the raw discovery pool is large and regenerable in one command
# (bin/discover-prospects.js). The selected candidate list and the grade reports
# are tracked; the full pool is not.
12_Brain/state/candidates/*-pool-*.json

# Arch factory build output — regenerable from the queue in one command
_templates/arch-factory/out/

# Quarantine lifted 2026-08-18: repo is PRIVATE, so raw comms, transcripts, and
# client reports now live IN the vault. That is the point — a brain cannot
# compound on evidence it is forbidden to hold. Secrets are still excluded below
# and enforced by _os/test/public-safety.test.js.
#
# Size-only exclusions. .git is already 3 GB of history; media stays local.
/videos/
*.mp4
*.mov

# Prospect Radar automation: source is tracked, artifacts are not.
# runs/ is 191 MB of dated receipts and generated-stock-library/ is 70 MB of
# approved image boards — both regenerable, neither belongs in a 3 GB history.
automation/*/runs/
automation/*/generated-stock-library/
automation/*/font-cache/
automation/*/.impeccable/
automation/*/*.log
automation/*/latest-daily-state.json

# managed-agents bridge runtime state
_os/automation/bridge/bridge.sqlite*
_os/automation/bridge/deliveries/
